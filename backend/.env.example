PORT=5000
MONGODB_USER=<your_atlas_username>
MONGODB_PASSWORD=<your_atlas_password>
MONGODB_CLUSTER=cluster0.nh9male.mongodb.net
MONGODB_DB=adama_citizen
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Email — smtp | auto | resend
# smtp  = Gmail/SMTP for all recipients (recommended without a verified domain)
# auto  = Resend first, then SMTP if Resend rejects
# resend = Resend only (onboarding@resend.dev can only mail your own inbox)
EMAIL_PROVIDER=smtp
EMAIL_FROM=Adama Citizen Portal <you@gmail.com>
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=
# Optional override; defaults to Adama Citizen Portal <SMTP_USER>
# SMTP_FROM=Adama Citizen Portal <you@gmail.com>
TEST_EMAIL=you@gmail.com

# Africa's Talking SMS
# Sandbox: AT_USERNAME=sandbox + sandbox API key from
# https://account.africastalking.com/apps/sandbox → Settings → API Key
# Then SMS_ENABLED=true.
# IMPORTANT: sandbox does NOT send to real phones. View messages at
# https://simulator.africastalking.com:1517 (register the same +251… number there).
# Live SMS needs a live app username (not "sandbox") + live API key + airtime.
SMS_ENABLED=false
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SMS_RETRY_ATTEMPTS=3
