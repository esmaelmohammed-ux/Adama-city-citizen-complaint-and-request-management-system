PORT=5100
# gemini | openai | heuristic (no API key needed)
# Free option: gemini (Google AI Studio — no card required for free tier)
# Paid option: openai
# Offline: heuristic
AI_PROVIDER=gemini
# Get free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — same DB as main app for similar-case search
MONGODB_URI=
# Or Atlas pieces (used only if MONGODB_URI is empty):
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_CLUSTER=cluster0.nh9male.mongodb.net
MONGODB_DB=adama_citizen
